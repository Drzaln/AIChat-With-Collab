# ═══════════════════════════════════════════════════════════
# 🔧 AI Chat Configuration
# ═══════════════════════════════════════════════════════════

# 🌐 BASE URL dari Google Colab (Cloudflare Tunnel URL)
# Ganti dengan URL yang diberikan oleh Google Colab setiap kali restart
# Contoh: https://xxxx-xxxx-xxxx.trycloudflare.com
BASE_URL=

# 🔑 API Key (default dari Colab notebook: sk-colab-local)
API_KEY=

# 🤖 Model name yang digunakan (sesuai mapping LiteLLM di Colab) / default model if you copy paste the script.
MODEL_NAME=character1

# 🌐 Port untuk web server lokal
PORT=3000

# 🌍 Bahasa Antarmuka (UI Language)
# Mendukung: EN, ID, JP, ES, FR, DE, ZH, RU, KO, AR, HI, PT
# Kosongkan atau isi dengan EN untuk default bahasa Inggris
UI_LANG=EN
