# ═══════════════════════════════════════════════════════════
# 🔧 AI Chat Configuration
# ═══════════════════════════════════════════════════════════

# 🌐 BASE URL from Google Colab (Cloudflare Tunnel URL)
# Replace with the URL provided by Google Colab on each restart
# Example: https://xxxx-xxxx-xxxx.trycloudflare.com
BASE_URL=

# 🔑 API Key (default from Colab notebook: sk-colab-local)
API_KEY=

# 🤖 Model name to use (according to LiteLLM mapping in Colab) / default model if you copy paste the script.
MODEL_NAME=character1

# 🌐 Port for local web server
PORT=3000

# 🌍 Interface Language (UI Language)
# Supported: EN, ID, JP, ES, FR, DE, ZH, RU, KO, AR, HI, PT
# Leave empty or set to EN for default English
UI_LANG=EN

# ═══════════════════════════════════════════════════════════
# ⚠️ DANGER / ALERT: DO NOT CHANGE IF YOU DON'T KNOW WHAT YOU ARE DOING
# ═══════════════════════════════════════════════════════════

# ⚙️ Model Request Generation Parameters
MAX_TOKENS=1024
TEMPERATURE=0.80
FREQUENCY_PENALTY=0.1
PRESENCE_PENALTY=0.1
TOP_P=0.90
TOP_K=50
